{
  "name": "league-table",
  "version": "0.1.0",
  "private": true,
  "main": "dist-electron/main.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "playwright test",
    "test:e2e": "playwright test --config=playwright.e2e.config.ts",
    "electron:build:main": "tsc -p tsconfig.electron.json",
    "electron:dev": "npm run electron:build:main && node scripts/electron-dev.mjs",
    "electron:prepare": "npm run build && npm run electron:build:main && node scripts/prepare-electron-deps.mjs",
    "electron:build": "npm run electron:prepare && electron-builder --publish=never",
    "electron:build:mac": "npm run electron:prepare && electron-builder --mac --publish=never",
    "electron:build:win": "npm run electron:prepare && electron-builder --win --publish=never"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "canvas": "^3.2.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "build": {
    "appId": "jp.ne.leaguetable.desktop",
    "productName": "リーグ戦しようよ",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": ".next",
        "to": "app/.next"
      },
      {
        "from": "public",
        "to": "app/public"
      },
      {
        "from": "assets",
        "to": "app/assets"
      },
      {
        "from": ".electron-deps/node_modules",
        "to": "app/node_modules"
      },
      {
        "from": "package.json",
        "to": "app/package.json"
      },
      {
        "from": "next.config.ts",
        "to": "app/next.config.ts"
      }
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.sports",
      "identity": "-",
      "hardenedRuntime": false
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
